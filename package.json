{
  "name": "fluent-css-framework",
  "version": "0.1.0",
  "description": "A CSS framework implementing Microsoft's Fluent Design System.",
  "main": "dist/fluent.css",
  "style": "dist/fluent.css",
  "exports": {
    ".": "./dist/fluent.css",
    "./min": "./dist/fluent.min.css",
    "./src/*": "./src/*"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "postcss src/index.css -o dist/fluent.css --map",
    "build:min": "cross-env NODE_ENV=production postcss src/index.css -o dist/fluent.min.css --map",
    "watch:css": "postcss src/index.css -o dist/fluent.css --map -w",
    "serve": "serve . -l 5500",
    "dev": "concurrently -n css,serve -c blue,green \"npm:watch:css\" \"npm:serve\""
  },
  "keywords": ["css", "fluent-design", "css-framework"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cssnano": "^9.0.4",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.5.2",
    "serve": "^14.2.6"
  }
}
